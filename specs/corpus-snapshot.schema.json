{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:novel-lens:gate-a:schema:corpus-snapshot:0.1.0",
  "title": "Gate A immutable corpus snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "snapshot_id",
    "hash_policy",
    "created_at",
    "documents"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "snapshot_id": {
      "$ref": "#/$defs/sha256"
    },
    "hash_policy": {
      "const": "ordered-document-content-v1"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "documents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/document"
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "document_id",
        "order",
        "title",
        "source_label",
        "media_type",
        "source_byte_sha256",
        "text_sha256",
        "source_byte_count",
        "char_count_utf16",
        "newline_style",
        "unicode_normalization",
        "bom",
        "empty",
        "text"
      ],
      "properties": {
        "document_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._~-]{0,127}$"
        },
        "order": {
          "type": "integer",
          "minimum": 0
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "source_label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "description": "Display label only; never an absolute path."
        },
        "media_type": {
          "enum": [
            "text/plain",
            "text/markdown"
          ]
        },
        "source_byte_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "text_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "source_byte_count": {
          "type": "integer",
          "minimum": 0
        },
        "char_count_utf16": {
          "type": "integer",
          "minimum": 0
        },
        "newline_style": {
          "enum": [
            "none",
            "lf",
            "crlf",
            "cr",
            "mixed"
          ]
        },
        "unicode_normalization": {
          "enum": [
            "nfc",
            "nfd",
            "nfkc",
            "nfkd",
            "mixed-or-unknown"
          ]
        },
        "bom": {
          "type": "boolean"
        },
        "empty": {
          "type": "boolean"
        },
        "text": {
          "type": "string"
        }
      }
    }
  }
}
