{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:novel-lens:gate-a:schema:lens-run:0.1.0",
  "title": "Gate A lens or generic baseline run",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "study_id",
    "study_version",
    "condition",
    "snapshot_id",
    "query_id",
    "query_text",
    "cutoff",
    "context_manifest",
    "provider",
    "prompt_hash",
    "output_schema_hash",
    "renderer_version",
    "requested_at",
    "completed_at",
    "status",
    "output",
    "usage"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._~-]{0,127}$"
    },
    "study_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "study_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "condition": {
      "enum": [
        "generic",
        "lens"
      ]
    },
    "snapshot_id": {
      "$ref": "#/$defs/sha256"
    },
    "query_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "query_text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "cutoff": {
      "$ref": "#/$defs/cutoff"
    },
    "context_manifest": {
      "$ref": "#/$defs/context_manifest"
    },
    "provider": {
      "$ref": "#/$defs/provider"
    },
    "prompt_hash": {
      "$ref": "#/$defs/sha256"
    },
    "output_schema_hash": {
      "oneOf": [
        {
          "$ref": "#/$defs/sha256"
        },
        {
          "type": "null"
        }
      ]
    },
    "renderer_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "requested_at": {
      "type": "string",
      "format": "date-time"
    },
    "completed_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "status": {
      "enum": [
        "pending",
        "completed",
        "cancelled",
        "coverage-failed",
        "provider-error",
        "invalid-model-output",
        "protocol-failure"
      ]
    },
    "output": {
      "oneOf": [
        {
          "$ref": "#/$defs/generic_output"
        },
        {
          "$ref": "#/$defs/lens_output"
        },
        {
          "$ref": "#/$defs/no_output"
        }
      ]
    },
    "usage": {
      "$ref": "#/$defs/usage"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "cutoff": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "document_id",
        "order",
        "inclusive",
        "label"
      ],
      "properties": {
        "document_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "order": {
          "type": "integer",
          "minimum": 0
        },
        "inclusive": {
          "const": true
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      }
    },
    "context_manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "eligible_document_ids",
        "sent_documents",
        "omitted_documents",
        "non_eligible_documents",
        "coverage_percent",
        "tools_enabled",
        "external_search_enabled",
        "user_consented_at"
      ],
      "properties": {
        "eligible_document_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "sent_documents": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sent_document"
          }
        },
        "omitted_documents": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/omitted_document"
          }
        },
        "non_eligible_documents": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/non_eligible_document"
          }
        },
        "coverage_percent": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "tools_enabled": {
          "const": false
        },
        "external_search_enabled": {
          "const": false
        },
        "user_consented_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "sent_document": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "document_id",
        "order",
        "text_sha256",
        "char_count_utf16"
      ],
      "properties": {
        "document_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "order": {
          "type": "integer",
          "minimum": 0
        },
        "text_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "char_count_utf16": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "omitted_document": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "document_id",
        "reason"
      ],
      "properties": {
        "document_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "reason": {
          "enum": [
            "context-limit",
            "provider-limit",
            "user-excluded",
            "decode-failure",
            "other"
          ]
        }
      }
    },
    "non_eligible_document": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "document_id",
        "reason"
      ],
      "properties": {
        "document_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "reason": {
          "enum": [
            "after-cutoff",
            "not-selected",
            "empty-document"
          ]
        }
      }
    },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider_id",
        "endpoint_origin",
        "requested_model_id",
        "returned_model_id",
        "max_output_tokens",
        "sampling",
        "store_requested",
        "truncation_policy",
        "request_id",
        "latency_ms"
      ],
      "properties": {
        "provider_id": {
          "enum": [
            "mock",
            "openai"
          ]
        },
        "endpoint_origin": {
          "type": "string",
          "format": "uri",
          "maxLength": 512
        },
        "requested_model_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "returned_model_id": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 128
        },
        "max_output_tokens": {
          "type": "integer",
          "minimum": 1
        },
        "sampling": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "temperature",
            "seed"
          ],
          "properties": {
            "temperature": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0,
              "maximum": 2
            },
            "seed": {
              "type": [
                "integer",
                "null"
              ]
            }
          }
        },
        "store_requested": {
          "const": false
        },
        "truncation_policy": {
          "const": "disabled"
        },
        "request_id": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 256
        },
        "latency_ms": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      }
    },
    "generic_output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "markdown"
      ],
      "properties": {
        "kind": {
          "const": "generic-markdown"
        },
        "markdown": {
          "type": "string"
        }
      }
    },
    "lens_output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "lens_id",
        "lens_version",
        "findings",
        "invalid_finding_count"
      ],
      "properties": {
        "kind": {
          "const": "validated-findings"
        },
        "lens_id": {
          "enum": [
            "first-reader",
            "consistency-candidate"
          ]
        },
        "lens_version": {
          "const": "0.1"
        },
        "findings": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "$ref": "urn:novel-lens:gate-a:schema:lens-finding:0.1.0"
          }
        },
        "invalid_finding_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "no_output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "error_code"
      ],
      "properties": {
        "kind": {
          "const": "none"
        },
        "error_code": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 128
        }
      }
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input_tokens",
        "output_tokens",
        "estimated_cost_minor_units",
        "currency"
      ],
      "properties": {
        "input_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "output_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "estimated_cost_minor_units": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "currency": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Z]{3}$"
        }
      }
    }
  }
}
