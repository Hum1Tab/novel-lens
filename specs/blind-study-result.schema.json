{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:novel-lens:gate-a:schema:blind-study-result:0.1.0",
  "title": "Blinded paired comparison result without manuscript text",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "study_id",
    "study_version",
    "participant_id",
    "pair_id",
    "case_id",
    "snapshot_id",
    "query_id",
    "run_a_id",
    "run_b_id",
    "display_order",
    "ratings",
    "preference",
    "preference_reason_codes",
    "condition_guess",
    "guess_confidence",
    "free_text_redacted",
    "timing",
    "protocol_status",
    "exclusion_reason",
    "sealed_mapping"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "study_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "study_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "participant_id": {
      "type": "string",
      "pattern": "^P-[A-Z0-9]{4,16}$"
    },
    "pair_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._~-]{0,127}$"
    },
    "case_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "snapshot_id": {
      "$ref": "#/$defs/sha256"
    },
    "query_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "run_a_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "run_b_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "display_order": {
      "enum": [
        "A-then-B",
        "B-then-A"
      ]
    },
    "ratings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "A",
        "B"
      ],
      "properties": {
        "A": {
          "$ref": "#/$defs/rating"
        },
        "B": {
          "$ref": "#/$defs/rating"
        }
      }
    },
    "preference": {
      "enum": [
        "A",
        "B",
        "tie",
        "both-reject"
      ]
    },
    "preference_reason_codes": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "more-specific",
          "better-evidence",
          "more-relevant",
          "less-generic",
          "less-prescriptive",
          "better-prioritised",
          "safer-uncertainty",
          "easier-to-use",
          "misleading",
          "other"
        ]
      }
    },
    "condition_guess": {
      "enum": [
        "A",
        "B",
        "cannot-tell"
      ]
    },
    "guess_confidence": {
      "$ref": "#/$defs/likert"
    },
    "free_text_redacted": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 4000,
      "description": "Moderator-reviewed comment with names and manuscript quotations removed."
    },
    "timing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "a_review_seconds",
        "b_review_seconds",
        "total_task_seconds"
      ],
      "properties": {
        "a_review_seconds": {
          "type": "integer",
          "minimum": 0
        },
        "b_review_seconds": {
          "type": "integer",
          "minimum": 0
        },
        "total_task_seconds": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "protocol_status": {
      "enum": [
        "valid",
        "excluded",
        "provider-protocol-failure"
      ]
    },
    "exclusion_reason": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 1000
    },
    "sealed_mapping": {
      "oneOf": [
        {
          "$ref": "#/$defs/mapping"
        },
        {
          "type": "null"
        }
      ],
      "description": "Never present in the participant-facing view."
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "rating": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "usefulness",
        "specificity",
        "evidence_trust",
        "novel_insight",
        "misleading_risk",
        "voice_pressure",
        "decision_confidence"
      ],
      "properties": {
        "usefulness": {
          "$ref": "#/$defs/likert"
        },
        "specificity": {
          "$ref": "#/$defs/likert"
        },
        "evidence_trust": {
          "$ref": "#/$defs/likert"
        },
        "novel_insight": {
          "$ref": "#/$defs/likert"
        },
        "misleading_risk": {
          "$ref": "#/$defs/likert"
        },
        "voice_pressure": {
          "$ref": "#/$defs/likert"
        },
        "decision_confidence": {
          "$ref": "#/$defs/likert"
        }
      }
    },
    "likert": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4
    },
    "mapping": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "A",
        "B",
        "randomization_seed_hash",
        "unsealed_at"
      ],
      "properties": {
        "A": {
          "enum": [
            "generic",
            "lens"
          ]
        },
        "B": {
          "enum": [
            "generic",
            "lens"
          ]
        },
        "randomization_seed_hash": {
          "$ref": "#/$defs/sha256"
        },
        "unsealed_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      }
    }
  }
}
