{
  "name": "@novel-lens/desktop",
  "version": "0.1.0",
  "description": "作者所有のMarkdown原稿、復元可能な履歴、根拠付きAIレンズを備えた日本語小説制作環境",
  "author": "Novel Lens contributors",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist-main/index.cjs",
  "scripts": {
    "build": "pnpm build:renderer && pnpm build:main",
    "build:renderer": "vite build",
    "build:main": "esbuild src/main/index.ts --bundle --platform=node --format=cjs --target=node22 --external:electron --outfile=dist-main/index.cjs && esbuild src/preload/index.ts --bundle --platform=node --format=cjs --target=node22 --external:electron --outfile=dist-preload/index.cjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "electron .",
    "dev": "pnpm build && electron .",
    "dist": "pnpm build && electron-builder",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true});require('node:fs').rmSync('dist-main',{recursive:true,force:true});require('node:fs').rmSync('dist-preload',{recursive:true,force:true});require('node:fs').rmSync('release',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@novel-lens/editor-core": "workspace:*",
    "@novel-lens/project-store": "workspace:*",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.1",
    "electron": "44.0.0",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "vite": "8.2.2"
  },
  "build": {
    "appId": "org.novellens.desktop",
    "productName": "Novel Lens",
    "asar": true,
    "artifactName": "Novel-Lens-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-main/**/*",
      "dist-preload/**/*",
      "package.json"
    ],
    "extraResources": [
      { "from": "../../LICENSE", "to": "LICENSE" },
      { "from": "../../NOTICE", "to": "NOTICE" }
    ],
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ]
    },
    "nsis": {
      "artifactName": "Novel-Lens-${version}-windows-${arch}-setup.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "portable": {
      "artifactName": "Novel-Lens-${version}-windows-${arch}-portable.${ext}"
    },
    "mac": {
      "target": ["dmg", "zip"],
      "category": "public.app-category.productivity",
      "hardenedRuntime": true,
      "gatekeeperAssess": false
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "category": "Office",
      "maintainer": "Novel Lens contributors",
      "synopsis": "Local-first Japanese novel writing environment"
    }
  }
}
